        "additionalProperties": false
      },
      "TripPlanPreviewResponse": {
        "type": "object",
        "properties": {
          "destinationId": {
            "type": "string",
            "nullable": true
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TripDayResponse"
            },
            "nullable": true
