              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripPlanPreviewResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripPlanPreviewResponse"
                }
              }
            }
          }
        }
      }
    }
